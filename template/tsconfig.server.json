{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false
  },
  "include": [
    "server.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "background/**/*.ts",
    "migrations/**/*.ts"
  ],
  "exclude": ["src/web.ts", "tests", "scripts"]
}
